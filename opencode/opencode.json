{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "betterstack": {
        "type": "remote",
        "url": "https://mcp.betterstack.com"
      }
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "amazon-bedrock", "effect": "deny" }
  ],
  "model": "openai/gpt-6.1-sol",
  "providers": {
    "ollama": {
      "name": "Ollama",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      }
    }
  },
  "default_agent": "plan",
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna"
    },
    "build": {
      // "model": "ollama/qwen3-coder-next:q4_K_M"
      // "model": "anthropic/claude-haiku-4-5",
      // "model": "anthropic/claude-sonnet-4-6",
      // "model": "opencode/claude-sonnet-4-6",
      // "model": "openai/gpt-5.3-codex-spark",
      "model": "openai/gpt-5.6-terra",
      "permissions": [
        { "action": "shell", "resource": "git *", "effect": "ask" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr *", "effect": "ask" }
      ]
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      // "model": "opencode/claude-sonnet-4-6",
      "mode": "subagent"
    },
    "plan": {
      // "model": "opencode/claude-opus-4-6",
      // "model": "openai/gpt-5.4",
      "model": "openai/gpt-6.1-sol",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git status", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "coast build", "effect": "ask" },
        { "action": "shell", "resource": "coast run *", "effect": "ask" },
        { "action": "shell", "resource": "coast ui", "effect": "ask" },
        { "action": "shell", "resource": "coast harness-setup-prompt *", "effect": "ask" },
        { "action": "shell", "resource": "coast docs", "effect": "allow" },
        { "action": "shell", "resource": "coast docs --path *", "effect": "allow" },
        { "action": "shell", "resource": "coast search-docs *", "effect": "allow" },
        { "action": "shell", "resource": "coast --version", "effect": "allow" },
        { "action": "shell", "resource": "coast help", "effect": "allow" },
        { "action": "shell", "resource": "coast build --help", "effect": "allow" },
        { "action": "shell", "resource": "coast run --help", "effect": "allow" },
        { "action": "shell", "resource": "coast ui --help", "effect": "allow" },
        { "action": "shell", "resource": "coast harness-setup-prompt --help", "effect": "allow" },
        { "action": "shell", "resource": "coast lookup", "effect": "allow" },
        { "action": "shell", "resource": "coast ls", "effect": "allow" },
        { "action": "shell", "resource": "coast ps", "effect": "allow" },
        { "action": "shell", "resource": "coast logs *", "effect": "allow" },
        { "action": "shell", "resource": "git worktree list", "effect": "allow" },
        { "action": "shell", "resource": "git worktree list --porcelain", "effect": "allow" },
        { "action": "shell", "resource": "pwd", "effect": "allow" },
        { "action": "shell", "resource": "docker compose config", "effect": "allow" },
        { "action": "shell", "resource": "docker compose ps", "effect": "allow" },
        { "action": "shell", "resource": "docker volume ls", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "tree *", "effect": "allow" },
        { "action": "shell", "resource": "wc *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm test*", "effect": "ask" },
        { "action": "shell", "resource": "docker compose logs *", "effect": "allow" },
        { "action": "shell", "resource": "dixie *", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "explore", "effect": "allow" }
      ]
    }
  }
}
